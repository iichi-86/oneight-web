      <path d="M49 82h32m-32 12h47" />
      <path d="M190 22c-13-5-26 7-20 20l-38 38c-9 9 4 22 13 13l38-38c13 5 25-7 20-20l-12 12-13-13z" fill="#fffefa" />
      <circle cx="139" cy="86" r="2" fill="currentColor" stroke="none" />
      <circle cx="74" cy="110" r="16" fill="#e4f35b" />
      <path d="m67 110 5 5 10-11" />
      <path d="M207 84v9m-4.5-4.5h9M21 54v7m-3.5-3.5h7" stroke="#b9ad85" />
    </g>
  </>}
</svg>

<style>
  .service-illustration {
    display: block;
    width: 100%;
    height: auto;
    max-height: 170px;
    color: #29323a;
    overflow: visible;
  }

  .illustration-drawing {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
