---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ServicePricingCards from '../components/ServicePricingCards.astro';
import TargetAudience from '../components/TargetAudience.astro';
import ServiceIllustration from '../components/ServiceIllustration.astro';
import SupportScope from '../components/SupportScope.astro';
import { site, faqs } from '../data/site';
import '../styles/home.css';
const { development } = site.pricing;
const capabilities = [
  { illustration: 'website', title: 'お店のWebサイト', text: '営業時間・メニュー・お店の魅力を、見つけやすく。更新のしやすさも考えます。' },
  { illustration: 'webapp', title: '店舗専用のWebアプリ', text: '会員証やスタンプ、お知らせなど。お客様とのつながりに合う機能を検討します。' },
];
const applications = [
  { icon: 'calendar', title: '予約・受注の管理', text: 'あちこちに分かれた予約や注文を、確認しやすい画面にまとめる方法を考えます。' },
  { icon: 'chart', title: '記録・集計の見える化', text: '毎日の数字や作業の記録を整理し、転記や確認の手間を減らす仕組みを考えます。' },
  { icon: 'message', title: 'お客様へのお知らせ', text: '新商品や営業日のお知らせを、無理なく続けられる形に。お店の運用に合わせます。' },
];
const steps = [
  { title: 'つくる内容を確認', text: 'WebサイトやWebアプリの用途、必要な機能、制作範囲と料金を確認します。' },
  { title: 'つくって、確かめる', text: 'AIや共通の仕組みも活用し、実際の使い方を確認しながら制作します。' },
  { title: '導入をサポート', text: 'できあがったWebサイトやWebアプリをお届けし、使い方を確認します。' },
  { title: 'お店で使い始める', text: '導入後の日々の運用はお店で。制作物の問題や不具合は無料で修正します。追加カスタマイズは別途お見積もりします。' },
];
---
<BaseLayout title={site.name}>
  <section class="development-hero" aria-labelledby="hero-title">
    <div class="container development-hero-grid">
      <div class="development-hero-copy">
        <p class="hero-service-label">地域のお店・教室のWebサイト・アプリ開発</p>
        <h1 id="hero-title" class="hero-simple-heading"><span class="hero-contract-promise">{development.priceMessage}</span><span class="hero-monthly-caption">2か月目から</span><span class="hero-monthly-price"><span>月額</span><strong>{development.monthlyLabel}</strong><small>円（税込）</small></span></h1>
        <p class="hero-initial-price">初期費用<strong>{development.initialLabel}<small>円</small></strong></p>
        <p class="hero-first-month">最初の1か月は、月額も{development.firstMonthMonthlyAmount}円。</p>
        <p class="hero-upgrade-note"><span>{development.basePriceScope}</span><span>{development.databaseUpgrade}</span><span>運用中の追加カスタマイズは、別途お見積もりします。</span></p>
        <p class="hero-introduction hero-introduction--plan">ONE EIGHTは、お店に合うWebサイト・Webアプリを制作し、導入までサポートするチームです。</p>
        <div class="hero-main-actions"><a class="button button--primary" href="/contact/">制作について問い合わせる</a><a class="hero-price-link" href="#services">サービス・料金を見る</a></div>
      </div>
      <ProductShowcase />
    </div>
    <div class="container hero-support-strip"><span>基本料金は月額1プラン</span><span>Web・アプリ開発の初期費用0円</span><span>制作から導入までサポート</span></div>
  </section>
  <TargetAudience />
  <ContactCTA title={'お店のWebサイト・Webアプリを、\nつくってみませんか。'} />
  <section class="section home-pricing" id="services" aria-labelledby="services-title">
    <div class="container"><div class="lp-heading"><p class="eyebrow">サービスと料金</p><h2 id="services-title">月額{development.monthlyLabel}円の、<br />シンプルな1プラン。</h2><p>初期費用は{development.initialLabel}円。<br class="desktop-break" />Webサイト・Webアプリの制作から、導入までサポートします。</p></div>
      <ServicePricingCards />
      <p class="section-note">{site.pricing.tax} 制作・対応範囲、お試しとデータベースのアップグレードは、<a href="/pricing/">料金ページ</a>でご案内しています。</p>
      <div class="home-support-scope"><SupportScope /></div>
    </div>
  </section>
  <section class="section capability-section" aria-labelledby="capability-title"><div class="container">
    <div class="lp-heading"><p class="eyebrow">制作するもの</p><h2 id="capability-title">お店のWebサイトと、<br />Webアプリをつくります。</h2><p>お店の魅力を届けるWebサイト。<br class="desktop-break" />お客様やスタッフが使うWebアプリ。基本は、この2つの制作です。</p></div>
    <div class="capability-grid">{capabilities.map(item => <article class="capability-item"><ServiceIllustration variant={item.illustration} /><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
    <div class="application-intro"><h3>ご依頼に応じた、Web制作の応用例</h3><p>予約・記録・お知らせなどの機能や、新しい仕組みも、必要に応じて内容と対応可否を確認します。</p></div>
    <div class="application-grid">{applications.map(item => <article><Icon name={item.icon} size={30} /><h4>{item.title}</h4><p>{item.text}</p></article>)}</div>
    <p class="section-note">応用例のすべてが基本料金に含まれるわけではありません。制作する内容と範囲は、ご依頼時に確認します。運用中の追加カスタマイズは別途費用がかかります。</p>
    <div class="section-actions"><a class="button button--outline" href="/service/">サービスを詳しく見る</a><a class="text-link" href="/contact/">制作について問い合わせる</a></div>
  </div></section>
  <section class="section making-examples" aria-labelledby="examples-title"><div class="container">
    <div class="lp-heading lp-heading--left"><p class="eyebrow">課題から考える制作イメージ</p><h2 id="examples-title">いつもの仕事に、<br />こんな使い方を。</h2><p>「どんなものを頼めるの？」を、身近な場面から。</p></div>
    <div class="example-pair">
      <article class="example-project"><div class="example-screen reservation-example" aria-hidden="true"><div class="example-toolbar"><span class="screen-circle"></span><span>予約一覧</span><span>画面サンプル</span></div><div class="example-screen-inner"><div class="example-screen-head"><strong>今日の予約</strong><span>カレンダー表示</span></div><div class="example-booking"><span>10:00</span><strong>カット＋カラー</strong><em>受付済み</em></div><div class="example-booking"><span>11:30</span><strong>カット</strong><em>確認待ち</em></div><div class="example-booking"><span>13:00</span><strong>トリートメント</strong><em>受付済み</em></div></div></div><div class="example-project-copy"><p class="example-category">美容院・ネイルサロン・教室など</p><h3>予約の確認を、ひとつの画面で。</h3><p>電話のメモとメッセージを何度も見比べる。そんな場面から、確認の流れに合う予約管理を考えます。</p></div></article>
      <article class="example-project"><div class="example-screen report-example" aria-hidden="true"><div class="example-toolbar"><span class="screen-circle"></span><span>お店の記録</span><span>画面サンプル</span></div><div class="example-screen-inner"><div class="example-screen-head"><strong>今週のふりかえり</strong><span>週間表示</span></div><div class="example-graph">{[44,72,56,92,68,100,78].map((height,i) => <div><i style={`height:${height}px`}></i><span>{['月','火','水','木','金','土','日'][i]}</span></div>)}</div><p class="example-report-note">毎日の記録を、まとめて確認</p></div></div><div class="example-project-copy"><p class="example-category">飲食店・小売店など</p><h3>閉店後の集計を、見直しやすく。</h3><p>何度も転記している数字や、散らばった記録。どこで手間が生まれるかを聞き、整理する仕組みを考えます。</p></div></article>
    </div>
    <p class="section-note">架空の画面による制作イメージです。導入実績ではありません。実際の製品・機能・デザインは、ご相談のうえ決定します。</p>
  </div></section>
  <section class="section development-flow" aria-labelledby="flow-title"><div class="container">
    <div class="lp-heading"><p class="eyebrow">制作から導入まで</p><h2 id="flow-title">つくって、お届けして、<br />お店で使い始める。</h2><p>導入までをサポートし、その後の運用はお店で。<br class="desktop-break" />内容と費用を確認しながら、一つずつ進めます。</p></div>
    <ol class="development-steps">{steps.map(step => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
    <div class="flow-consult"><div><h3>専門用語も、企画書もいりません。</h3><p>つくりたいWebサイト・Webアプリの用途をお送りください。</p></div><a class="button button--primary" href="/contact/">制作について問い合わせる</a></div>
  </div></section>
  <section class="section team-origin" aria-labelledby="origin-title"><div class="container origin-layout">
    <div><p class="eyebrow">ONE EIGHTについて</p><h2 id="origin-title">原点は、<br />実家の和菓子屋。</h2><div class="origin-sign">お店の方と、<br />同じ目線で考えたい。</div></div>
    <div class="origin-copy"><p>同じ個人店でも、困っていることはそれぞれ違う。<br />実家の仕事を身近に見て、そのことを学んできました。</p><p>私たちは大学生のチームです。お店の話を聞く時間と柔軟さを大切に、AIや共通の仕組みも使って、制作の手間と費用を抑えます。</p><p>必要な機能を見極め、小さくつくって、使い方を確かめる。お店の方の「これ、助かるな」を、一つずつ増やしていきたいと考えています。</p><a class="text-link" href="/about/">私たちの考え方を知る</a></div>
  </div></section>
  <section class="section home-faq" id="faq" aria-labelledby="faq-title"><div class="container faq-layout"><div class="lp-heading lp-heading--left"><p class="eyebrow">よくあるご質問</p><h2 id="faq-title">制作の前に、<br />気になること。</h2></div><div class="faq-list">{faqs.map(faq => <details><summary>{faq.question}<span aria-hidden="true" class="faq-toggle"></span></summary><p>{faq.answer}</p></details>)}</div></div></section>
  <ContactCTA title={'お店のWebサイト・Webアプリを、\nここから。'} />
</BaseLayout>
