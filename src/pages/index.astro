---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { site, faqs } from '../data/site';
import '../styles/home.css';
const examples = [
  { icon: 'grid', title: 'お店のWebサイト', description: 'お店の魅力や必要な情報が、お客様に伝わる接点を。' },
  { icon: 'card', title: '会員・顧客との接点', description: '会員証やお知らせなど、通い続けたくなる仕組みを検討。' },
  { icon: 'bell', title: '予約・受注の整理', description: '電話や紙に分かれた情報を、扱いやすい流れへ。' },
  { icon: 'grid', title: '業務情報の共有', description: '日々の確認や転記など、手作業が多い仕事を見直す。' },
  { icon: 'stamp', title: '運用と改善', description: '使って分かる課題に向き合い、必要な改善を続ける。' },
];
const steps = [
  ['無料ヒアリング', 'お店の状況と、日々困っていることをお聞きします。'],
  ['分析・ご提案', '原因を整理し、取り組む課題と解決方法を考えます。'],
  ['条件の事前合意', '達成条件・固定報酬額・実施期間を一緒に決めます。'],
  ['制作・開発', 'AIや共通の仕組みを活かし、必要なシステムを制作します。'],
  ['一緒に運用・改善', '現場で使いながら、達成条件に向けて調整します。'],
  ['達成確認・固定報酬', '事前に合意した条件を満たした時点で報酬が発生します。'],
  ['解決後の継続支援', '継続契約に応じて、月額で保守・運用・改善を支援します。'],
];
---
<BaseLayout title={site.name}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-kicker"><span class="tiny-line"></span>地域の個人店の課題解決・Webアプリ開発</p>
      <h1 id="hero-title">お店の課題に、<br /><span>いっしょに答えを。</span></h1>
      <p class="hero-description">そのお店だけの困りごとを、<br />AIとテクノロジーで、解決へ。<br />相談から開発、運用・改善まで伴走するONE EIGHTです。</p>
      <div class="hero-actions"><a href="/contact/" class="button button--primary">お店の課題を無料相談</a><a href="/service/" class="hero-detail-link">サービスを知る</a></div>
      <p class="hero-note">ヒアリング・ご提案は無料。取り組む条件は、着手前に合意します。</p>
    </div>
    <div class="hero-visual">
      <div class="hero-arch" aria-hidden="true"><span class="arch-orbit"></span><span class="arch-orbit arch-orbit--second"></span></div>
      <span class="visual-caption">YOUR SHOP, YOUR NEXT STEP.</span>
      <div class="hero-phone-back"><PhoneMockup variant="stamp" /></div>
      <div class="hero-phone-main"><PhoneMockup /></div>
      <div class="floating-label floating-label--member"><span class="label-icon"><Icon name="card" size={22} /></span><span>お店の課題から、<br /><strong>必要な仕組みへ。</strong></span></div>
      <div class="floating-label floating-label--stamp"><span class="stamp-flower"><Icon name="flower" size={24} /></span><span>つくったあとも、<br />一緒に運用・改善。</span></div>
      <p class="visual-disclaimer">画面イメージ・架空店舗のサンプルです。<br />実際の機能・デザインは課題に合わせて検討します。</p>
    </div>
  </section>
  <div class="audience-strip"><div class="container audience-inner"><span>地域のお店の、身近な相談相手に。</span><div><span>ベーカリー</span><span>カフェ</span><span>菓子店</span><span>美容サロン</span><span>トリミングサロン</span></div></div></div>

  <section class="section introduction" aria-labelledby="intro-title"><div class="container intro-grid" data-reveal>
    <div><p class="eyebrow">START WITH YOUR SHOP</p><h2 id="intro-title">お店が違えば、<br />困りごとも違う。</h2></div>
    <div class="intro-copy"><p>手作業に時間がかかる。<br />予約や注文の確認が大変。<br />お客様に、伝えたい情報が届かない。</p><p>大切なのは、そのお店で何が起きているか。<br />経営者のお話を聞き、原因を整理し、<br />無理なく取り組める解決方法を考えます。</p><p>ONE EIGHTは、<strong>課題の発見から、開発・運用・改善まで。<br />お店と一緒に、課題解決を目指します。</strong></p></div>
  </div></section>

  <section class="section service-section" aria-labelledby="service-title"><div class="container">
    <div class="section-heading service-heading" data-reveal><div><p class="eyebrow">OUR SERVICE</p><h2 id="service-title">お店を支える、<br />2つの取り組み。</h2></div><p>お話を聞くことから、<br />必要な仕組みをつくり、使い続けることまで。<br />お店の状況に合わせてご提案します。</p></div>
    <div class="business-pair" data-reveal>
      <article><p class="eyebrow">WEB & APP DEVELOPMENT</p><h3>店舗専用のWeb・アプリ開発</h3><p>お店の魅力を伝えるWebサイト、お客様とつながるアプリ、日々の仕事を支える業務システム。課題に合った機能と、お店らしいデザインを考えます。</p></article>
      <article><p class="eyebrow">PROBLEM SOLVING</p><h3>固有の課題の発見・解決・運用支援</h3><p>無料ヒアリングで課題の原因を整理し、達成条件を事前に合意。AIやテクノロジーを活用し、お店と一緒に運用・改善しながら解決へ取り組みます。</p></article>
    </div>
    <div class="service-showcase" data-reveal>
      <div class="showcase-visual"><span class="showcase-word" aria-hidden="true">together.</span><div class="showcase-phone"><PhoneMockup variant="card" /></div><span class="showcase-label">専用アプリの画面イメージ</span></div>
      <div class="showcase-copy"><span class="outlined-label">課題に合った仕組みを。</span><h3>共通の仕組みを活かして、<br />お店に必要な部分を調整。</h3><p>ゼロからすべてをつくる負担を抑えながら、お店ごとの業務や使い方に合わせます。専用開発や既存サービスの活用など、必要性と実現可能性を確認して解決方法を検討します。</p><div class="showcase-points"><p><Icon name="check" size={18} />お店の状況を聞いてからご提案</p><p><Icon name="check" size={18} />必要な機能と対応範囲を事前に整理</p><p><Icon name="check" size={18} />導入後の使い方・運用も一緒に検討</p></div><a class="text-link" href="/service/">サービスを詳しく見る</a></div>
    </div>
    <div class="feature-heading"><h3>こんなご相談から、はじめられます。</h3><p>以下は課題と解決方法の例です。対応可否や具体的な機能は、個別に確認します。</p></div>
    <div class="feature-grid">{examples.map(example => <div class="feature-item"><div class="feature-icon"><Icon name={example.icon} size={26} /></div><h3>{example.title}</h3><p>{example.description}</p></div>)}</div>
  </div></section>

  <section class="section possibilities" aria-labelledby="possibility-title"><div class="container"><div class="section-heading" data-reveal><p class="eyebrow">EVERYDAY CHALLENGES</p><h2 id="possibility-title">お店の日常にある、<br />小さな「困った」から。</h2></div>
    <div class="possibility-grid" data-reveal><article><span class="possibility-illustration illustration-card" aria-hidden="true"><i></i><i></i><b>your work.</b></span><h3>紙や手作業で、時間がかかる。</h3><p>同じ内容の転記や、情報を探す作業。今の流れを整理し、負担を減らす仕組みを考えます。</p></article><article><span class="possibility-illustration illustration-message" aria-hidden="true"><i></i><b>お店から、お客様へ。</b><i></i></span><h3>お店の情報を、届けたい。</h3><p>新商品や季節の便りを伝えたい。Webサイトやアプリなど、お客様との接点を検討します。</p></article><article><span class="possibility-illustration illustration-shop" aria-hidden="true"><b>your shop.</b><i></i></span><h3>予約・注文の確認を、整理したい。</h3><p>電話、メモ、スタッフ間の共有。お店の使い方に合わせて、情報を確認しやすい流れを考えます。</p></article></div>
    <p class="section-footnote">ご相談例です。導入実績や効果を示すものではなく、売上等の向上を保証するものでもありません。</p>
  </div></section>

  <section class="section approach-section" aria-labelledby="approach-title"><div class="container"><div class="section-heading" data-reveal><p class="eyebrow">HOW WE WORK</p><h2 id="approach-title">身近に、柔軟に。<br />つくる負担を、小さく。</h2></div><div class="approach-grid" data-reveal><article><h3>向き合う時間と柔軟さ</h3><p>大学生ならではの時間と柔軟性を活かし、お店のお話を聞きながら、現場に合う方法を一緒に探します。</p></article><article><h3>AIを活用した制作</h3><p>開発の補助にAIを活用し、費用や制作期間の無駄を抑えます。業務の理解や動作の確認も大切にします。</p></article><article><h3>共通の仕組みを土台に</h3><p>共通化できる部分を活かし、お店ごとに必要な部分を調整。導入しやすさと、個別の使い方への対応を考えます。</p></article></div></div></section>

  <section class="section pricing-section" aria-labelledby="pricing-title"><div class="container pricing-overview" data-reveal><div class="pricing-intro"><p class="eyebrow">AGREE BEFORE WE START</p><h2 id="pricing-title">条件を一緒に決めて、<br />解決した時に、固定報酬。</h2><p>{site.pricing.consultation}<br />{site.pricing.initialFee}<br />達成条件・報酬額・実施期間は、着手前に合意します。</p><a class="text-link" href="/pricing/">料金と対応範囲を詳しく見る</a></div><div class="price-card"><div class="price-card-top"><span>課題解決時の固定報酬</span><span class="price-status">事前合意・税込</span></div><p class="price-amount"><strong>{site.pricing.projectMinimum / 10000}〜{site.pricing.projectMaximum / 10000}</strong><span>万円程度</span></p><p class="price-tax">売上に対する歩合ではありません。金額は課題に応じて事前に設定します。</p><p class="price-conditions">{site.pricing.settlement}</p><div class="price-divider"></div><p class="initial-fee">解決後も、必要な支援を。</p><ul class="home-plan-list">{site.pricing.plans.map(plan => <li><span>{plan.name}</span><strong>月額 {plan.monthlyLabel}円<span>（税込）</span></strong></li>)}</ul><p class="price-conditions">{site.pricing.monthlyStart}</p><a class="button button--primary" href="/contact/">お店の課題を無料相談</a></div></div></section>

  <section class="section flow-section" aria-labelledby="flow-title"><div class="container"><div class="section-heading"><p class="eyebrow">OUR PROCESS</p><h2 id="flow-title">発見から解決、<br />その先の運用まで。</h2><p>お店の状況を確認し、合意した条件に沿って進めます。</p></div><ol class="flow-list flow-list--problem-solving">{steps.map((step, i) => <li><span class="step-label">STEP {i + 1}</span><h3>{step[0]}</h3><p>{step[1]}</p></li>)}</ol></div></section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="container faq-grid"><div><p class="eyebrow">QUESTIONS & ANSWERS</p><h2 id="faq-title">気になること、<br />お答えします。</h2><p>報酬や進め方について、<br />ご相談の前にご確認ください。</p></div><div class="faq-list">{faqs.map(faq => <details><summary>{faq.question}<span class="faq-toggle" aria-hidden="true"></span></summary><p>{faq.answer}</p></details>)}</div></div></section>

  <section class="section about-teaser"><div class="container about-teaser-inner"><div class="about-mark" aria-hidden="true">oneight<span></span></div><div><p class="eyebrow">ABOUT ONE EIGHT</p><h2>原点は、<br />実家の和菓子屋。</h2><p>一つひとつのお店に、それぞれの課題がある。<br />そのことを身近に学んだ経験から、地域の個人店の味方になる事業を目指しています。</p><a class="text-link" href="/about/">ONE EIGHTの想いを読む</a></div></div></section>
  <ContactCTA />
</BaseLayout>
