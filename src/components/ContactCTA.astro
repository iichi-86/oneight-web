---
interface Props { title?: string; }
const { title = 'お店のWebサイト・Webアプリを、\n一緒につくりましょう。' } = Astro.props;
---
<section class="contact-cta section" aria-label="制作に関するお問い合わせ">
  <div class="container cta-inner">
    <div><p class="eyebrow">Webサイト・Webアプリ制作</p><h2>{title.split('\n').map(line => <span>{line}</span>)}</h2><p>つくりたいWebサイトやWebアプリの用途を、<br />短い言葉でお知らせください。</p></div>
    <div class="cta-action"><a class="button button--primary" href="/contact/">制作について問い合わせる</a><p class="cta-small">制作・導入の内容と費用は、制作前に確認します。</p></div>
  </div>
</section>
