---
import BaseLayout from '../layouts/BaseLayout.astro';
import NeighborhoodIllustration from '../components/NeighborhoodIllustration.astro';
import '../styles/details.css';

const solutions = [
  { kind: 'news', label: 'お店を知ってもらう', title: '「営業時間、どこを見ればわかる？」', name: 'お店のWebサイト', text: '営業時間はSNS、メニューは写真、予約は電話。お客様が迷ってしまうなら、必要な情報をまとめたホームページを。お店の方が更新しやすい方法も考えます。' },
  { kind: 'manage', label: '毎日の仕事を手助け', title: '予約のメモが、あちこちに。', name: '予約・受注の管理システム', text: '紙とメッセージを行ったり来たりして、予約を確認していませんか。今の受付方法を聞いたうえで、一覧や受け渡しの確認画面などを検討します。' },
  { kind: 'member', label: 'また来てもらうきっかけ', title: 'あのお客様に、新商品を知らせたい。', name: 'お店専用のWebアプリ', text: '会員証やスタンプ、新商品のお知らせなど。お客様とのつながりを続けるために何が必要か、お店の接客に合う使い方から相談できます。' },
  { kind: 'insight', label: '閉店後の作業も', title: '毎日の集計、もう少し楽にならない？', name: '記録の整理・確認画面', text: '数字を何度も書き写したり、別々の表を見比べたり。どこに手間がかかっているか確認して、記録をまとめる方法や、見やすい画面を考えます。' },
];

const flow = [
  { title: 'まず、お話を聞きます', text: 'ヒアリングとご提案は無料です。いつ、どんな作業で困っているか。まとまっていなくても、そのまま聞かせてください。' },
  { title: 'ゴールと金額を決めます', text: '原因と解決方法を整理したら、達成条件・固定報酬・実施期間・制作する範囲を一緒に確認。納得いただいてから作り始めます。' },
  { title: '作って、一緒に使ってみる', text: 'AIも活用して、お店専用のサイトやアプリを制作します。実際の仕事で使いながら、決めたゴールに向けて手を入れていきます。' },
  { title: '条件を達成したら、お支払い', text: '事前に決めた方法で、達成できたかを一緒に確認します。合意した条件を満たした時点で、決めておいた固定報酬をいただきます。' },
  { title: 'その後のことも相談できます', text: '課題解決後の継続契約から、原則として月額保守が始まります。プランに合わせ、システムの維持や運用、改善をお手伝いします。' },
];
---

<BaseLayout title="サービス｜成功報酬で、お店の困りごとを解決" description="制作費の先払いは原則不要。ONE EIGHTは、お店と事前に決めたゴールを達成した時に、合意した固定報酬をいただく仕組みです。無料相談から専用Webサイト・アプリの制作、運用まで一緒に取り組みます。">
  <section class="page-hero detail-service-hero friendly-service-hero">
    <div class="container detail-hero-grid">
      <div>
        <p class="eyebrow">お店のWeb制作・毎日の業務改善</p>
        <h1>ゴール達成で、<br />成功報酬。</h1>
        <p class="page-lead">何をもって解決とするか、お店と先に約束。<br class="desktop-break" />その条件を達成した時に、決めておいた固定額をいただきます。</p>
        <p class="detail-hero-note friendly-success-note"><strong>制作費の先払いは、原則不要です。</strong><br />外部サービスなどの費用が必要な場合も、着手前に確認します。</p>
        <a class="button button--primary" href="/contact/">まずは無料で話してみる</a>
      </div>
      <div class="detail-service-visual friendly-service-visual">
        <NeighborhoodIllustration eager />
        <p class="detail-visual-caption">お店の話を聞いて、一緒に考えるところから。</p>
      </div>
    </div>
  </section>

  <section class="section detail-intro friendly-success-explanation">
    <div class="container detail-editorial-grid">
      <div><p class="eyebrow">「成功報酬」って？</p><h2 class="section-heading">「できた！」の基準を、<br />先に決めます。</h2></div>
      <div class="detail-body-copy">
        <p>たとえば、予約を確認するたびに、紙とメッセージを行き来しているお店なら。「予約を一つの画面で確認できる状態にする」など、お店が困っていることに合わせてゴールを考えます。</p>
        <p>何を確認して達成とするか、いつまでに取り組むか、報酬はいくらか。作り始める前に一緒に決めて、合意した条件を満たした時にお支払いいただきます。</p>
        <p>報酬は事前に決める固定額です。売上の何％という仕組みではありません。未達の場合や途中で中止する場合、期間を延ばす場合の扱いも、先に確認します。</p>
        <a class="detail-text-link" href="/pricing/">報酬の目安と、解決後の保守料金を見る</a>
      </div>
    </div>
    <div class="container detail-access-strip">
      <div><span class="detail-access-symbol" aria-hidden="true">相談</span><p><strong>まずは無料</strong><span>お店の困りごとを聞かせてください</span></p></div>
      <div><span class="detail-access-symbol" aria-hidden="true">約束</span><p><strong>ゴール・金額・期間</strong><span>作り始める前に、一緒に決めます</span></p></div>
      <div><span class="detail-access-symbol" aria-hidden="true">達成</span><p><strong>条件を達成してお支払い</strong><span>事前に決めた固定報酬です</span></p></div>
    </div>
  </section>

  <section class="section detail-features friendly-service-examples" id="features">
    <div class="container">
      <div class="detail-section-intro"><div><p class="eyebrow">こんなこと、気になっていませんか</p><h2 class="section-heading">「ここが面倒で…」<br />そんな話から。</h2></div><p>ホームページ、店舗アプリ、業務システム。<br />何が必要かは、お店のお話を聞いてから考えます。</p></div>
      <div class="detail-feature-grid">
        {solutions.map((solution) => <article class="detail-feature">
          <div class:list={['detail-feature-art', `detail-art-${solution.kind}`]} aria-hidden="true">
            {solution.kind === 'news' && <div class="detail-mini-news"><span>お店のホームページ</span><b>今日は、営業しています。</b><i></i><i></i><i></i></div>}
            {solution.kind === 'manage' && <div class="detail-mini-manage"><span>今日の予約・受け渡し</span><div><i></i><i></i><i></i></div><hr /><hr /><hr /></div>}
            {solution.kind === 'member' && <div class="detail-mini-member"><span>お店の会員証</span><b>また来てね。</b><div class="detail-mini-barcode"></div></div>}
            {solution.kind === 'insight' && <div class="detail-mini-insight"><span>今月は、どんな調子？</span><div><i></i><i></i><i></i><i></i><i></i></div><small>データの表示イメージ</small></div>}
          </div>
          <div class="detail-feature-copy"><p class="eyebrow">{solution.label}</p><h3>{solution.title}</h3><p class="detail-feature-name">{solution.name}</p><p>{solution.text}</p></div>
        </article>)}
      </div>
      <p class="detail-section-note">ここで紹介しているのは、ご相談内容と制作の例です。導入実績や、完成済みの機能を示すものではありません。必要な機能は、お店ごとに相談して決めます。</p>
    </div>
  </section>

  <section class="section detail-approach friendly-service-making">
    <div class="container detail-editorial-grid">
      <div><p class="eyebrow">どうやって作るの？</p><h2 class="section-heading">お店のやり方を聞いて、<br />小さく作ってみます。</h2></div>
      <div class="detail-body-copy">
        <p>いつ、誰が、どんなふうに使うのか。今ある道具や仕事の流れも聞きながら、お店専用のWebサイトやアプリを作ります。</p>
        <p>制作にはAIを活用し、共通で使える仕組みも取り入れます。制作の手間や費用を抑えながら、お店に必要な部分を調整。実際に使ってもらい、気づいたことを聞きながら、決めた課題の解決に向けて改善します。</p>
        <p>従来の月額制の店舗向けWebアプリについても、引き続きご相談いただけます。</p>
      </div>
    </div>
  </section>

  <section class="section detail-flow-section friendly-service-flow">
    <div class="container"><p class="eyebrow">ご相談から、そのあとまで</p><h2 class="section-heading">こんな順番で進めます。</h2>
      <ol class="detail-flow">{flow.map((step) => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
      <p class="detail-section-note">大規模な追加開発や、新しい課題への対応は別途お見積もりします。外部サービス利用料などの負担も、着手前に確認します。</p>
    </div>
  </section>

  <section class="detail-bottom-cta"><div class="container"><div><p class="eyebrow">まだ、まとまっていなくても大丈夫</p><h2>最近、何に手間がかかっていますか。</h2><p>「毎日これをするのが大変」で、十分です。<br />お話を聞いて、できそうなことを一緒に考えます。</p></div><div class="detail-cta-actions"><a class="button button--primary" href="/contact/">まずは無料で話してみる</a><a class="detail-text-link" href="/pricing/">料金を詳しく見る</a></div></div></section>
</BaseLayout>
