---
import BaseLayout from '../layouts/BaseLayout.astro';
import NeighborhoodIllustration from '../components/NeighborhoodIllustration.astro';
import ShopSketch from '../components/ShopSketch.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ServicePricingCards from '../components/ServicePricingCards.astro';
import { site, faqs } from '../data/site';
import '../styles/home.css';
const shopQuestions = [
  { kind: 'notebook' as const, name: '予約や注文のこと', quote: '「あの予約、どこに書いたっけ？」', text: '電話、メモ、メッセージに分かれた予約。お店の流れに合った確認方法を、一緒に考えます。', example: 'たとえば、予約・受注の管理画面' },
  { kind: 'shop' as const, name: '毎日の作業のこと', quote: '「この集計、もっと楽にならないかな」', text: '同じ数字の転記や、毎日の確認。いつもの作業を聞きながら、減らせる手間を探します。', example: 'たとえば、お店専用の業務システム' },
  { kind: 'letter' as const, name: 'お客様へのお知らせ', quote: '「新商品、常連さんにも伝えたい」', text: '営業日や季節の商品を、もっと届けやすく。Webサイトやアプリなど、続けやすい方法を選びます。', example: 'たとえば、Webサイト・会員アプリ' },
];
---
<BaseLayout title={site.name}>
  <section class="welcome welcome--two-services" aria-labelledby="hero-title">
    <div class="container welcome-grid">
      <div class="welcome-copy">
        <p class="welcome-kicker">地域の個人店の、ちいさな相談相手。</p>
        <p class="upfront-note">Web・アプリ制作と、課題の相談</p>
        <h1 id="hero-title">お店に合うもの、<br /><span>一緒につくろう。</span></h1>
        <p class="welcome-description">作りたいものがある方も、<br />何を変えたらいいか迷っている方も。<br />二つのサービスで、お店の仕事をお手伝いします。</p>
        <a href="#services" class="button button--primary">2つのサービス・料金を見る</a>
        <p class="welcome-small">まずは無料ヒアリングから。内容と費用を確認して進めます。</p>
      </div>
      <figure class="welcome-art">
        <p class="art-handnote">お店の人と、同じテーブルで。</p>
        <NeighborhoodIllustration eager />
        <figcaption>お店と一緒に考える、支援のイメージです。</figcaption>
      </figure>
    </div>
    <div class="container start-promise"><span><i aria-hidden="true"></i>無料ヒアリングから</span><span><i aria-hidden="true"></i>作りたいもの・困りごとを相談</span><span><i aria-hidden="true"></i>費用と対応範囲を先に確認</span></div>
  </section>

  <section class="section two-services" id="services" aria-labelledby="services-title"><div class="container">
    <div class="everyday-heading"><p class="eyebrow">お店に合わせた、2つのお手伝い</p><h2 id="services-title">作りたいものからでも、<br />困りごとからでも。</h2><p class="two-services-intro">Webサイトやアプリを作りたい方には、制作と運用のサービスを。<br />お店の課題から考えたい方には、製品づくりにつながるコンサルをご用意しています。</p></div>
    <ServicePricingCards />
    <p class="section-note">{site.pricing.tax} それぞれの制作・対応範囲や、お試し・返金の条件は、料金ページでご確認ください。</p>
  </div></section>

  <section class="section shop-questions" aria-labelledby="questions-title">
    <div class="container"><div class="everyday-heading"><p class="eyebrow">こんなこと、ありませんか？</p><h2 id="questions-title">いつもの仕事の中に、<br />お手伝いできることがあるかもしれません。</h2></div>
      <div class="question-scenes">{shopQuestions.map(question => <article class="question-scene"><div class="scene-art"><ShopSketch kind={question.kind} /></div><p class="scene-topic">{question.name}</p><h3>{question.quote}</h3><p>{question.text}</p><p class="scene-example">{question.example}</p></article>)}</div>
      <p class="section-note">ご相談例です。実際に作るものや対応できることは、お店の状況を伺って決めます。</p>
      <a class="text-link" href="/service/">できることを見てみる</a>
    </div>
  </section>

  <section class="section shop-process" aria-labelledby="process-title"><div class="container process-layout">
    <div class="process-intro"><p class="eyebrow">ご相談からの進め方</p><h2 id="process-title">いつもの仕事の話から<br />始めましょう。</h2><p>何を作るか、決まっていなくても大丈夫。<br />困っている場面を、そのまま聞かせてください。</p><ShopSketch kind="notebook" /></div>
    <ol class="process-notes">
      <li><span>まずは、お話を聞く</span><h3>どこで困っていますか？</h3><p>予約の確認、毎日の集計、お客様への連絡。お店のやり方や、困っている場面を伺います。まずは無料ヒアリングで、状況を聞かせてください。</p></li>
      <li><span>サービスと費用を確認する</span><h3>どんなお手伝いが必要か、一緒に。</h3><p>選ぶサービスと、検討・制作する内容、費用を確認します。コンサルは、解決策の検討に進む時点から有料です。納得いただいてから次へ進みます。</p></li>
      <li><span>つくって、使ってみる</span><h3>お店の仕事に取り入れてみましょう。</h3><p>事前に確認した内容に沿って、サイトやアプリ、得意な製品を形にします。使い始めたあとの対応や、製品の改良・改善も、サービスごとの範囲を決めて進めます。</p></li>
    </ol>
  </div></section>

  <section class="section our-letter"><div class="container letter-layout"><div class="letter-art"><ShopSketch kind="shop" /><p>はじめまして、ワンエイトです。</p></div><div class="letter-copy"><p class="eyebrow">この仕事を始める理由</p><h2>実家は、和菓子屋です。</h2><p>個人店といっても、困っていることはそれぞれ違う。<br />実家の仕事を身近に見て、そのことを学んできました。</p><p>私たちは大学生です。お店のお話を聞く時間と柔軟さを大切に、AIや共通の仕組みも使って、制作の手間と費用を抑えます。</p><p>お店の方の「これ、助かるな」を、一つずつ増やしたい。<br />そんな気持ちで、ONE EIGHTを始めています。</p><a class="text-link" href="/about/">私たちのことをもう少し</a></div></div></section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="container faq-grid"><div><p class="eyebrow">よくいただくご質問</p><h2 id="faq-title">相談する前に、<br />気になること。</h2><ShopSketch kind="letter" /></div><div class="faq-list">{faqs.map(faq => <details><summary>{faq.question}<span class="faq-toggle" aria-hidden="true"></span></summary><p>{faq.answer}</p></details>)}</div></div></section>
  <ContactCTA />
</BaseLayout>
