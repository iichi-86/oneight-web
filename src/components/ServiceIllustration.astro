---
interface Props {
  variant: string;
  class?: string;
}

const { variant, class: className } = Astro.props;
const variants = ['website', 'webapp', 'handoff', 'customize', 'repair'];
const drawing = variants.includes(variant) ? variant : 'website';
---

<svg class:list={['service-illustration', `service-illustration--${drawing}`, className]} viewBox="0 0 240 140" fill="none" aria-hidden="true" focusable="false">
  {drawing === 'website' && <>
    <ellipse cx="124" cy="77" rx="94" ry="53" fill="#eaf0e5" />
    <g class="illustration-drawing">
      <rect x="32" y="21" width="174" height="103" rx="7" fill="#fffefa" />
      <path d="M33 40h172" />
      <circle cx="43" cy="31" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="50" cy="31" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="57" cy="31" r="1.5" fill="currentColor" stroke="none" />
      <path d="M78 31h67" stroke="#b3bdb1" />
      <rect x="45" y="51" width="60" height="59" rx="3" fill="#f0f4e6" stroke="none" />
      <path d="M52 71h46v30H52z" fill="#fffefa" />
      <path d="m49 70 5-12h40l6 12" fill="#f4c5bb" />
      <path d="M49 70c0 5 8 5 8 0 0 5 9 5 9 0 0 5 9 5 9 0 0 5 9 5 9 0 0 5 8 5 8 0 0 5 8 5 8 0" fill="#f4c5bb" />
      <path d="M66 59v10m18-10v10" stroke="#c8877b" />
      <path d="M59 81h13v12H59zM81 101V81h10v20" />
      <path d="M118 57h65m-65 11h49m-49 12h58" />
      <rect x="118" y="94" width="47" height="15" rx="3" fill="#e4f35b" stroke="none" />
      <path d="m180 93 0 24 6-7 8 2z" fill="#fffefa" />
      <path d="M17 53v8m-4-4h8M219 93v8m-4-4h8" stroke="#8eaa93" />
    </g>
  </>}

  {drawing === 'webapp' && <>
    <ellipse cx="121" cy="77" rx="81" ry="51" fill="#fae8e2" />
    <g class="illustration-drawing">
      <rect x="82" y="8" width="77" height="125" rx="13" fill="#fffefa" />
      <path d="M111 17h19" />
      <rect x="91" y="34" width="59" height="53" rx="5" fill="#eaf0e5" />
      <path d="M101 47h17m-17 9h27" />
      <rect x="101" y="66" width="8" height="8" fill="currentColor" stroke="none" />
      <rect x="113" y="66" width="8" height="8" fill="currentColor" stroke="none" />
      <path d="M126 67h13m-13 7h9" stroke-width="1.7" />
      <circle cx="101" cy="101" r="5" fill="#e4f35b" stroke="none" />
      <circle cx="120" cy="101" r="5" fill="#e4f35b" stroke="none" />
      <circle cx="139" cy="101" r="5" fill="#e4f35b" stroke="none" />
      <path d="M113 122h15" />
      <path d="M57 57c-7 0-11 5-11 11s4 11 11 11m128-16c7 0 11 5 11 11s-4 11-11 11" stroke="#cc9e90" />
      <path d="M62 103v9m-4.5-4.5h9M179 32v8m-4-4h8" stroke="#cc9e90" />
    </g>
  </>}

  {drawing === 'handoff' && <>
    <ellipse cx="124" cy="79" rx="101" ry="47" fill="#eaf0e5" />
