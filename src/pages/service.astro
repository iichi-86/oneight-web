---
import BaseLayout from '../layouts/BaseLayout.astro';
import TargetAudience from '../components/TargetAudience.astro';
import '../styles/details.css';

const solutions = [
  { kind: 'news', label: '情報発信', title: '必要な情報が見つかるWebサイト', name: 'Webサイト・ホームページ', text: '営業時間、メニュー、サービス、アクセス。SNSや紙に分かれた情報を整理し、お客様が知りたいことにたどり着きやすい構成を考えます。更新する方の使い方も確認します。' },
  { kind: 'manage', label: '業務管理', title: '予約・受注をまとめて確認', name: '予約・受注の管理画面', text: '紙やメッセージに分かれた予約、受け渡しの確認、何度も転記する作業。現在の受付方法と仕事の流れを整理し、お店に合う管理の仕組みを検討します。' },
  { kind: 'member', label: 'お客様との接点', title: '会員サービスをWebアプリに', name: '店舗・教室向けWebアプリ', text: '会員証、スタンプ、お知らせなど、お客様との継続的な接点をつくる仕組み。接客や利用の場面に合わせて、必要な機能と画面を組み立てます。' },
  { kind: 'insight', label: '情報整理・集計', title: '日々の記録を、確認しやすく', name: '記録・集計を支えるツール', text: '数字の書き写しや、複数の表を見比べる手間を整理。何を記録し、どの情報を確認したいかを伺い、作業に合う入力方法や確認画面を考えます。' },
];

const flow = [
  { title: 'ヒアリング', text: 'ヒアリングは無料です。つくりたいもの、現在の業務、困っている場面を伺います。要件が決まっていない段階からご相談いただけます。' },
  { title: '内容・費用の確認', text: '課題と目的を整理し、制作するもの、対応範囲、費用、進め方を確認します。内容に合意してから制作へ進みます。' },
  { title: '設計・制作', text: '実際に使う方の操作や仕事の流れに合わせて設計します。AIも活用して制作を進め、画面や使い方を確認します。' },
  { title: '提供・利用確認', text: '制作したものをお届けし、利用方法を確認します。コンサルの料金は、製品の提供時にお支払いいただきます。' },
  { title: '運用・改良', text: '継続利用に必要な内容を確認します。コンサル製品の維持費は製品に応じて設定し、改良・改善に充てます。保守や支援の範囲は契約前にご案内します。' },
];
---

<BaseLayout title="サービス｜Webサイト・アプリ開発と課題解決の製品づくり" description="地域のお店・教室に向けたWebサイト・アプリ開発と、課題に合わせた製品の制作・提供。ONE EIGHTは、無料ヒアリングで目的と業務を整理し、内容・費用を確認して制作します。コンサル料金は製品の提供時にお支払いいただきます。">
  <section class="page-hero detail-service-hero refresh-service-hero">
    <div class="container detail-hero-grid">
      <div>
        <p class="eyebrow">サービス</p>
        <h1>お店の仕事を、<br />使える仕組みに。</h1>
        <p class="page-lead">Webサイト・アプリの開発から、<br class="desktop-break" />日々の課題に応える製品づくりまで。<br />目的と業務を整理し、お店に合う形で制作します。</p>
        <div class="refresh-hero-actions"><a class="button button--primary" href="/contact/">無料でひとこと相談する</a><a class="detail-text-link" href="#service-lines">2つのサービスを見る</a></div>
        <p class="detail-hero-note">つくるものが決まっていない段階でも、ご相談いただけます。</p>
      </div>
      <div class="refresh-product-board" role="img" aria-label="店舗管理画面と会員向けWebアプリの構成例。実際の導入画面や利用データではありません。">
        <div class="refresh-browser">
          <div class="refresh-browser-bar"><span></span><span></span><span></span><b>業務管理画面</b></div>
          <div class="refresh-browser-body">
            <div class="refresh-browser-nav"><strong>SHOP DESK</strong><i class="is-active">予約・受注</i><i>商品・サービス</i><i>お知らせ</i><i>記録・集計</i></div>
            <div class="refresh-browser-content"><p>予約・受注</p><div class="refresh-screen-summary"><span>受付内容を一覧で確認</span><b>＋ 新規登録</b></div><div class="refresh-screen-row refresh-screen-row--head"><span>受付内容</span><span>対応状況</span></div><div class="refresh-screen-row"><span>ご予約のサンプル</span><b>受付済み</b></div><div class="refresh-screen-row"><span>ご注文のサンプル</span><b>確認中</b></div><div class="refresh-screen-row"><span>受け渡しのサンプル</span><b>対応済み</b></div></div>
          </div>
        </div>
        <div class="refresh-phone"><div class="refresh-phone-top"></div><span>お店のWebアプリ</span><strong>いつものお店と、<br />もっと身近に。</strong><div class="refresh-phone-member"><small>会員証</small><b>YOUR SHOP</b><i></i></div><div class="refresh-phone-links"><span>お知らせ</span><span>スタンプ</span></div><p>お店からのお知らせ</p><div class="refresh-phone-news"></div><div class="refresh-phone-news"></div></div>
        <p class="refresh-board-caption">画面構成の例です。制作する機能・デザインは個別に確認します。</p>
      </div>
    </div>
  </section>

  <TargetAudience />

  <section id="service-lines" class="section detail-intro refresh-service-overview">
    <div class="container">
      <div class="detail-section-intro"><div><p class="eyebrow">目的に合わせて選ぶ</p><h2 class="section-heading">2つのサービスで、<br />制作と課題解決を支援。</h2></div><p>サイトやアプリをつくりたい方も、<br />業務の困りごとから相談したい方も。<br />ヒアリングで進め方を整理します。</p></div>
      <div class="refresh-service-lines">
        <article><p class="refresh-service-number">つくりたいものから</p><h3>Webサイト・アプリ開発</h3><p class="refresh-service-summary">情報を届ける。お客様とつながる。</p><p>ホームページや会員向けWebアプリなど、お店・教室専用のサイトやアプリを制作します。発信する内容と必要な機能を整理し、利用する方にも更新する方にも使いやすい構成を考えます。</p><a class="detail-text-link" href="/pricing/#development">開発の料金・お試しについて</a></article>
        <article><p class="refresh-service-number">困りごとから</p><h3>課題解決の製品づくり<span>コンサルティング</span></h3><p class="refresh-service-summary">業務の課題に、使える製品を。</p><p>お店の課題を解決するための製品を、得意な技術で制作・提供します。無料ヒアリングで状況を伺い、製品の内容と費用を確認して制作。料金は製品の提供時にお支払いいただきます。</p><a class="detail-text-link" href="/pricing/#consulting">提供内容・料金・返金条件について</a></article>
      </div>
    </div>
  </section>

  <section class="section detail-features refresh-service-scope" id="features">
    <div class="container">
      <div class="detail-section-intro"><div><p class="eyebrow">対応領域</p><h2 class="section-heading">情報発信から、<br />日々の業務を支える仕組みまで。</h2></div><p>必要な機能は、業務と利用の場面から整理します。<br />以下は、ご相談いただける制作例です。</p></div>
      <div class="detail-feature-grid">
        {solutions.map((solution) => <article class="detail-feature">
          <div class:list={['detail-feature-art', `detail-art-${solution.kind}`]} aria-hidden="true">
            {solution.kind === 'news' && <div class="detail-mini-news"><span>WEB SITE</span><b>営業日・サービスのご案内</b><i></i><i></i><i></i></div>}
            {solution.kind === 'manage' && <div class="detail-mini-manage"><span>予約・受注の管理</span><div><i></i><i></i><i></i></div><hr /><hr /><hr /></div>}
            {solution.kind === 'member' && <div class="detail-mini-member"><span>MEMBERS CARD</span><b>YOUR SHOP</b><div class="detail-mini-barcode"></div></div>}
            {solution.kind === 'insight' && <div class="detail-mini-insight"><span>記録・集計の確認</span><div><i></i><i></i><i></i><i></i><i></i></div><small>表示イメージ</small></div>}
          </div>
          <div class="detail-feature-copy"><p class="eyebrow">{solution.label}</p><h3>{solution.title}</h3><p class="detail-feature-name">{solution.name}</p><p>{solution.text}</p></div>
        </article>)}
      </div>
      <p class="detail-section-note">掲載内容は制作の例であり、導入実績や標準提供機能を示すものではありません。実現する内容と対応範囲は、制作前に個別に確認します。</p>
      <div class="refresh-detail-contact"><div><h3>要件の整理から、ご相談ください。</h3><p>現在の業務や、つくりたいものを無料ヒアリングで伺います。</p></div><a class="button button--primary" href="/contact/">無料でひとこと相談する</a></div>
    </div>
  </section>

  <section class="section detail-approach refresh-service-approach">
    <div class="container"><div class="detail-section-intro"><div><p class="eyebrow">開発の考え方</p><h2 class="section-heading">現場で使えることを、<br />設計の基準に。</h2></div><p>画面をつくる前に、仕事の流れを理解する。<br />制作と利用の条件を共有して進めます。</p></div>
      <div class="detail-principles"><article><h3>業務から要件を決める</h3><p>誰が、いつ、どの情報を使うか。現在の道具と作業を確認し、制作する範囲と必要な操作を整理します。</p></article><article><h3>AIと共通の仕組みを活用</h3><p>AIを制作の補助に使い、共通化できる仕組みも活用。制作の手間を抑えながら、お店ごとの使い方に合わせて調整します。</p></article><article><h3>利用・運用の条件を共有</h3><p>提供後の使い方や、必要な維持費も事前にご案内します。保守や運用支援の具体的な範囲は、契約前に確認します。</p></article></div>
    </div>
  </section>

  <section class="section detail-flow-section refresh-service-flow">
    <div class="container"><p class="eyebrow">制作の流れ</p><h2 class="section-heading">相談から制作、<br />その後の利用まで。</h2><ol class="detail-flow">{flow.map((step) => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol><p class="detail-section-note">料金、お試し、返金、維持費の詳しい条件は、<a class="detail-text-link" href="/pricing/">料金ページ</a>をご覧ください。</p></div>
  </section>

  <section class="detail-bottom-cta"><div class="container"><div><p class="eyebrow">ヒアリングは無料です</p><h2>つくりたいものも、<br />解決したい課題も。</h2><p>現在の状況を伺い、取り組む内容と進め方を整理します。</p></div><div class="detail-cta-actions"><a class="button button--primary" href="/contact/">無料でひとこと相談する</a><a class="detail-text-link" href="/pricing/">料金・契約条件を見る</a></div></div></section>
</BaseLayout>
