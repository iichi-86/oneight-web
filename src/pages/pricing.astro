---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { site } from '../data/site';
import '../styles/details.css';
const agreements = [
  { title: '取り組む課題と達成条件', text: '何を改善し、何をもって解決とするか。現状や確認するデータ、測定方法、店舗側にお願いする準備も一緒に整理します。' },
  { title: '固定報酬と実施期間', text: '課題の難易度・経済的価値・開発工数を踏まえ、報酬額と実施期間を合意します。金額を事前に決める方式です。' },
  { title: '運用と変更時の扱い', text: '条件未達・中断・延長が生じた場合の対応や費用、外部サービス利用料、追加の課題が出た際の進め方も、着手前に確認します。' },
];
---
<BaseLayout title="料金｜課題解決時の固定報酬と月額支援" description="ONE EIGHTの料金は、事前合意した条件達成時の固定報酬3万〜20万円程度と、解決後の月額保守5,000円・10,000円・20,000円。すべて税込。ヒアリング・提案は無料、制作費の先払いは原則不要です。">
  <section class="page-hero detail-pricing-hero"><div class="container"><p class="eyebrow">Pricing</p><h1>解決した時の報酬と、<br />その先を支える月額。</h1><p class="page-lead">達成条件・固定報酬額・実施期間を、着手前に合意。<br />お店の課題と、必要な支援の範囲に合わせて決めます。</p></div></section>

  <section class="section detail-price-section"><div class="container detail-price-layout">
    <div class="detail-price-context"><p class="eyebrow">Project fee</p><h2 class="section-heading">条件を達成した時に、<br />事前合意の固定報酬。</h2><p>{site.pricing.consultation}<br />{site.pricing.initialFee}</p><p>{site.pricing.conditions}</p><p class="muted">売上の何％かを受け取る方式ではありません。<br />事前に合意した条件に沿って、達成状況を確認します。</p></div>
    <div class="detail-price-card"><div class="detail-price-card-top"><h3>課題解決時の固定報酬</h3><p>税込・目安</p></div><p class="detail-price-amount"><strong>{site.pricing.projectMinimum / 10000}〜{site.pricing.projectMaximum / 10000}</strong><span class="detail-price-yen">万円程度</span></p><p class="detail-price-tax">{site.pricing.tax}課題に応じて個別にお見積もりします。</p><div class="detail-price-initial"><span>報酬が発生するタイミング</span><p>{site.pricing.settlement}</p></div><p class="detail-price-conditions">{site.pricing.payment}</p><a class="button button--primary" href="/contact/">課題と費用を無料で相談する</a></div>
  </div></section>

  <section class="section maintenance-section" aria-labelledby="maintenance-title"><div class="container"><div class="detail-section-intro"><div><p class="eyebrow">After the solution</p><h2 id="maintenance-title" class="section-heading">解決したあとも、<br />一緒に使い続けるために。</h2></div><p>{site.pricing.monthlyStart}<br />必要な支援に合わせて、3つのプランからご相談いただけます。</p></div>
    <div class="maintenance-plans">{site.pricing.plans.map(plan => <article class="maintenance-plan"><p class="eyebrow">Monthly support</p><h3>{plan.name}</h3><p class="maintenance-summary">{plan.summary}</p><p class="maintenance-amount"><span>月額</span><strong>{plan.monthlyLabel}</strong><span>円</span></p><p class="maintenance-tax">税込</p><ul>{plan.services.map(service => <li>{service}</li>)}</ul><a class="button button--outline" href="/contact/">この支援内容を相談する</a></article>)}</div>
    <div class="pricing-scope-note"><p><strong>対応範囲は、ご契約前に具体化します。</strong><br />{site.pricing.contract}</p><p>{site.pricing.extra}</p></div>
  </div></section>

  <section class="section"><div class="container"><div class="detail-section-intro"><div><p class="eyebrow">Agree before we start</p><h2 class="section-heading">お互いの認識を、<br />はじめに揃えます。</h2></div><p>同じゴールを見ながら取り組めるように、<br />契約前に、条件と進め方を確認します。</p></div><div class="detail-principles">{agreements.map(item => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>

  <section class="section detail-price-questions"><div class="container"><p class="eyebrow">Before you decide</p><h2 class="section-heading">料金について、<br />ご相談の前に。</h2><dl class="detail-terms-list"><div><dt>制作費の先払い</dt><dd>{site.pricing.initialFee}支払時期や例外的な費用が生じる場合の扱いは、契約前に確認します。</dd></div><div><dt>条件未達・実施期間の変更</dt><dd>当初の条件に届かない場合、判定が難しい場合、実施期間を終えた場合の対応や費用の扱いは、着手前に確認します。</dd></div><div><dt>追加開発・新たな課題</dt><dd>{site.pricing.extra}</dd></div><div><dt>月額制の店舗専用アプリ</dt><dd>店舗専用アプリを月額制で導入・運用するご相談も、引き続き受け付けています。課題解決型のプランとの違いや適した契約方式は、個別にご案内します。</dd></div></dl></div></section>
  <ContactCTA title={'まずは、お店のことを。\n課題と費用を、一緒に整理します。'} />
</BaseLayout>
