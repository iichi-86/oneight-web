---
import BaseLayout from '../layouts/BaseLayout.astro';
import NeighborhoodIllustration from '../components/NeighborhoodIllustration.astro';
import TargetAudience from '../components/TargetAudience.astro';
import '../styles/details.css';

const solutions = [
  { kind: 'news', label: 'お店を知ってもらう', title: '「営業時間、どこを見ればわかる？」', name: 'お店のWebサイト', text: '営業時間はSNS、メニューは写真、予約は電話。お客様が迷ってしまうなら、必要な情報をまとめたホームページを。お店の方が更新しやすい方法も考えます。' },
  { kind: 'manage', label: '毎日の仕事を手助け', title: '予約のメモが、あちこちに。', name: '予約・受注の管理システム', text: '紙とメッセージを行ったり来たりして、予約を確認していませんか。今の受付方法を聞いたうえで、一覧や受け渡しの確認画面などを検討します。' },
  { kind: 'member', label: 'また来てもらうきっかけ', title: 'あのお客様に、新商品を知らせたい。', name: 'お店専用のWebアプリ', text: '会員証やスタンプ、新商品のお知らせなど。お客様とのつながりを続けるために何が必要か、お店の接客に合う使い方から相談できます。' },
  { kind: 'insight', label: '閉店後の作業も', title: '毎日の集計、もう少し楽にならない？', name: '記録の整理・確認画面', text: '数字を何度も書き写したり、別々の表を見比べたり。どこに手間がかかっているか確認して、記録をまとめる方法や、見やすい画面を考えます。' },
];

const flow = [
  { title: 'まず、お話を聞きます', text: 'ヒアリングは無料です。作りたいものや、いつもの仕事で困っていること。まとまっていなくても、そのまま聞かせてください。' },
  { title: '課題・製品内容・費用を確認', text: 'お店の課題を整理して、サイトやアプリ、解決に役立つ製品の内容を決めます。制作・提供する範囲と費用をご案内し、合意してから進めます。' },
  { title: '合意したものを制作します', text: 'AIも活用して、お店のサイトやアプリ、課題に合う製品を制作します。決めた範囲に沿って、必要な情報や実際の使い方を確認しながら進めます。' },
  { title: '製品をお届けします', text: '制作したものをお届けし、使い方を一緒に確認します。コンサルの料金は、製品の提供時にお支払いいただきます。' },
  { title: '使い方や、その後のことも', text: '公開や利用に向けて、使い方を一緒に確認します。コンサルで提供する製品は、製品に応じた維持費を改良・改善に充てます。内容と費用は事前にご案内します。' },
];
---

<BaseLayout title="サービス｜Webサイト・アプリ開発と、お店・教室のコンサル" description="ONE EIGHTは、地域のお店・教室に向けたWebサイト・アプリ開発と、課題に合わせた製品の制作・提供を行っています。コンサルでは無料ヒアリングで課題を聞き、製品内容と費用を確認して制作。料金は製品の提供時にお支払いいただきます。">
  <section class="page-hero detail-service-hero friendly-service-hero">
    <div class="container detail-hero-grid">
      <div>
        <p class="eyebrow">Webサイト・アプリ開発とコンサルティング</p>
        <h1>お店の相談、<br />形にします。</h1>
        <p class="page-lead">お店や教室のホームページ、アプリを作りたい。<br />毎日の作業を、もう少し楽にしたい。<br />二つの支援から、状況に合う進め方をご案内します。</p>
        <p class="detail-hero-note friendly-success-note"><strong>ヒアリングは無料です。</strong><br />作りたいものがある方も、困りごとから話したい方もどうぞ。</p>
        <a class="button button--primary" href="/contact/">無料でひとこと相談する</a>
      </div>
      <div class="detail-service-visual friendly-service-visual">
        <NeighborhoodIllustration eager />
        <p class="detail-visual-caption">お店の話を聞いて、一緒に考えるところから。</p>
      </div>
    </div>
  </section>

  <TargetAudience />

  <section class="section detail-intro friendly-success-explanation">
    <div class="container detail-editorial-grid">
      <div><p class="eyebrow">何から相談しよう？</p><h2 class="section-heading">二つの入り口を<br />用意しています。</h2></div>
      <div class="detail-scene-list">
        <article><p class="detail-scene-type">① Webサイト・アプリ開発</p><h3>お店の情報やサービスを、Webに。</h3><p>ホームページや会員アプリなど、お店専用のサイト・アプリを制作します。載せたい情報や使いたい機能を聞き、お店の方もお客様も使いやすい形を考えます。</p></article>
        <article><p class="detail-scene-type">② コンサルティング</p><h3>困りごとに合う製品を作ります。</h3><p>お店の課題を解決するための製品を、得意な技術で制作・提供するサービスです。無料ヒアリングで状況を聞き、製品の内容と費用を確認して制作へ。料金は、製品の提供時にお支払いいただきます。</p></article>
        <p class="detail-section-note"><a class="detail-text-link" href="/pricing/">それぞれの料金・試用や返金の条件を見る</a></p>
      </div>
    </div>
    <div class="container detail-access-strip">
      <div><span class="detail-access-symbol" aria-hidden="true">相談</span><p><strong>ヒアリング無料</strong><span>お店の話を聞かせてください</span></p></div>
      <div><span class="detail-access-symbol" aria-hidden="true">確認</span><p><strong>内容と費用を決めて制作</strong><span>お店の課題に合うものを作ります</span></p></div>
      <div><span class="detail-access-symbol" aria-hidden="true">提供</span><p><strong>製品をお届け</strong><span>コンサル料金は製品の提供時に</span></p></div>
    </div>
  </section>

  <section class="section detail-features friendly-service-examples" id="features">
    <div class="container">
      <div class="detail-section-intro"><div><p class="eyebrow">こんなこと、気になっていませんか</p><h2 class="section-heading">「ここが面倒で…」<br />そんな話から。</h2></div><p>ホームページ、店舗アプリ、業務システム。<br />何が必要かは、お店のお話を聞いてから考えます。</p></div>
      <div class="detail-feature-grid">
        {solutions.map((solution) => <article class="detail-feature">
          <div class:list={['detail-feature-art', `detail-art-${solution.kind}`]} aria-hidden="true">
            {solution.kind === 'news' && <div class="detail-mini-news"><span>お店のホームページ</span><b>今日は、営業しています。</b><i></i><i></i><i></i></div>}
            {solution.kind === 'manage' && <div class="detail-mini-manage"><span>今日の予約・受け渡し</span><div><i></i><i></i><i></i></div><hr /><hr /><hr /></div>}
            {solution.kind === 'member' && <div class="detail-mini-member"><span>お店の会員証</span><b>また来てね。</b><div class="detail-mini-barcode"></div></div>}
            {solution.kind === 'insight' && <div class="detail-mini-insight"><span>今月は、どんな調子？</span><div><i></i><i></i><i></i><i></i><i></i></div><small>データの表示イメージ</small></div>}
          </div>
          <div class="detail-feature-copy"><p class="eyebrow">{solution.label}</p><h3>{solution.title}</h3><p class="detail-feature-name">{solution.name}</p><p>{solution.text}</p></div>
        </article>)}
      </div>
      <p class="detail-section-note">ここで紹介しているのは、ご相談内容と制作の例です。導入実績や、完成済みの機能を示すものではありません。必要な機能は、お店ごとに相談して決めます。</p>
    </div>
  </section>

  <section class="section detail-approach friendly-service-making">
    <div class="container detail-editorial-grid">
      <div><p class="eyebrow">どうやって作るの？</p><h2 class="section-heading">お店のやり方を聞いて、<br />小さく作ってみます。</h2></div>
      <div class="detail-body-copy">
        <p>いつ、誰が、どんなふうに使うのか。今ある道具や仕事の流れも聞きながら、お店専用のWebサイトやアプリ、課題に合う製品を作ります。</p>
        <p>制作にはAIを活用し、共通で使える仕組みも取り入れます。制作の手間や費用を抑えながら、お店に必要な部分を調整。画面や使い方を確認して、実際の仕事に取り入れやすい形を考えます。</p>
      </div>
    </div>
  </section>

  <section class="section detail-flow-section friendly-service-flow">
    <div class="container"><p class="eyebrow">ご相談から、そのあとまで</p><h2 class="section-heading">こんな順番で進めます。</h2>
      <ol class="detail-flow">{flow.map((step) => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
      <p class="detail-section-note">製品によっては、改良・改善に充てる維持費がかかります。詳しい料金や試用・返金の条件は、<a class="detail-text-link" href="/pricing/">料金ページ</a>をご覧ください。</p>
    </div>
  </section>

  <section class="detail-bottom-cta"><div class="container"><div><p class="eyebrow">まだ、まとまっていなくても大丈夫</p><h2>最近、何に手間がかかっていますか。</h2><p>「毎日これをするのが大変」で、十分です。<br />お話を聞いて、できそうなことを一緒に考えます。</p></div><div class="detail-cta-actions"><a class="button button--primary" href="/contact/">無料でひとこと相談する</a><a class="detail-text-link" href="/pricing/">料金を詳しく見る</a></div></div></section>
</BaseLayout>
