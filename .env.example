# Build-time public configuration. No secrets belong in PUBLIC_ variables.
# Optional override; unset uses the approved https://oneight.jp in src/data/deployment.json.
PUBLIC_SITE_URL=
PUBLIC_ALLOW_INDEXING=false
# Enable only after the runtime configuration, policy and delivery checks are complete.
PUBLIC_CONTACT_ENABLED=false
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Pages Functions runtime settings. In local Pages tests use .dev.vars;
# in production use the Pages dashboard's encrypted secret variables.
# Do not commit real values or put these in the front-end build.
CONTACT_ENABLED=false
CONTACT_ALLOWED_ORIGIN=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
