      <path d="M66 36h27" stroke="#a5b4bf" />
      <rect x="46" y="56" width="39" height="45" rx="3" fill="#eaf0e5" stroke="none" />
      <path d="M99 60h51m-51 12h38m-38 12h28" />
      <circle cx="182" cy="37" r="18" fill="#e4f35b" />
      <path d="M182 29v16m-8-8h16" />
      <path d="m119 100 38-38 13 13-38 38-17 4z" fill="#f3c9bc" />
      <path d="m119 100 13 13m19-45 13 13m-49 36 5-2-3-3z" fill="#fffefa" />
      <path d="M20 70v8m-4-4h8M200 98v8m-4-4h8" stroke="#9badbe" />
    </g>
  </>}

  {drawing === 'repair' && <>
    <ellipse cx="121" cy="79" rx="95" ry="48" fill="#f3edda" />
    <g class="illustration-drawing">
      <rect x="35" y="28" width="144" height="84" rx="7" fill="#fffefa" />
      <path d="M36 46h142" />
      <circle cx="46" cy="37" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="53" cy="37" r="1.5" fill="currentColor" stroke="none" />
