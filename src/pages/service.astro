---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import '../styles/details.css';

const features = [
  { kind: 'member', en: 'MEMBERSHIP', title: '「いつものお店」の会員証。', name: 'デジタル会員証・会員管理', text: 'お客様のスマートフォンに、お店専用の会員証を。紙のカードを持ち歩かなくても、会員サービスにアクセスできる仕組みを検討しています。' },
  { kind: 'stamp', en: 'STAMP & POINT', title: '次の来店が、少し楽しみに。', name: 'スタンプカード・ポイント', text: '来店やお買い物の楽しみを、デジタルのスタンプやポイントに。付与の方法や特典の条件は、お店の運用に合わせて検討します。' },
  { kind: 'coupon', en: 'COUPON', title: 'お店から、うれしいきっかけを。', name: 'クーポン・会員限定特典', text: '季節のキャンペーンや会員限定のお知らせを、お店らしい特典として届けるために。発行方法や利用ルールも一緒に整理します。' },
  { kind: 'news', en: 'NEWS & MENU', title: '伝えたいことを、ひとつの場所に。', name: 'お知らせ・商品・サービス一覧', text: '新商品や営業日、メニューなどをまとめ、お客様が必要な情報を見つけやすく。情報の更新方法も含めてご提案を検討します。' },
  { kind: 'manage', en: 'STORE MANAGEMENT', title: 'お店の日常に、なじむ使い方を。', name: '店舗側の管理画面', text: '会員情報やお知らせなどを、お店側で管理するための画面を想定しています。使う人や作業の流れを確認し、必要な操作を考えます。' },
  { kind: 'insight', en: 'CUSTOMER INSIGHT', title: 'お客様との接点を、振り返る。', name: '顧客の利用状況の確認・分析', text: '会員サービスの利用傾向を、お店の施策を考えるヒントに。確認できる項目やデータの扱いは、実証を通じて決めていく予定です。' },
];

const scenes = [
  { type: 'ベーカリー・お菓子店', tag: 'また立ち寄りたくなる接点に', text: 'お買い物のスタンプと、新商品のご案内をひとつに。日々のおいしさを、会員サービスでも伝える使い方を考えられます。' },
  { type: 'カフェ・コーヒースタンド', tag: 'お店の空気まで伝わる場所に', text: 'メニューや豆の紹介、季節のお知らせを、お店の色や雰囲気と一緒に。来店の前後にも、お客様がお店に触れられる場所を目指します。' },
  { type: '美容・ネイル・トリミングサロン', tag: '次のご相談につながる関係に', text: '会員向けのお知らせやサービス紹介を、スマートフォンで確認しやすく。お店ごとの接客や運用に合わせ、必要な機能を検討します。' },
];

const flow = [
  { title: 'お問い合わせ', text: 'まとまっていなくても大丈夫です。気になっていることや、お店のお困りごとをお聞かせください。' },
  { title: 'ヒアリング', text: 'お客様との接点、現在の会員サービス、日々の運用について一緒に整理します。' },
  { title: 'ご提案・デモ', text: '必要な機能、デザインの方向性、費用や進め方をご相談します。デモのご案内は準備状況に応じます。' },
  { title: '制作・設定', text: '合意した内容をもとに制作・設定。実際の使い方を確認しながら、導入の準備を進めます。' },
  { title: '公開・運用開始', text: 'お客様へのご案内や店舗での使い方を確認し、継続的な運用を目指します。' },
];
---

<BaseLayout title="サービス｜店舗専用Webアプリの制作・運用" description="地域の個人店舗に向けたoneightのWebアプリ制作・運用サービス。会員証、スタンプ、クーポンなど、検討中の機能やお店での利用シーンをご紹介します。">
  <section class="page-hero detail-service-hero">
    <div class="container detail-hero-grid">
      <div>
        <p class="eyebrow">Service</p>
        <h1>お店らしさを、<br />いつものスマホに。</h1>
        <p class="page-lead">会員証も、お知らせも、お店の空気も。<br class="desktop-break" />お客様とのつながりを育てる、お店専用のWebアプリ。</p>
        <p class="detail-hero-note">oneightは、地域の個人店舗・小規模事業者に向けた<br class="desktop-break" />アプリの制作・運用サービスを準備しています。</p>
        <a class="button button--primary" href="/contact/">無料相談・デモ相談</a>
      </div>
      <div class="detail-service-visual">
        <div class="detail-orbit" aria-hidden="true"></div>
        <span class="detail-visual-label">YOUR SHOP, YOUR APP.</span>
        <PhoneMockup variant="home" compact />
        <p class="detail-visual-caption">画面イメージ・架空の店舗を用いたデザイン例</p>
      </div>
    </div>
  </section>

  <section class="section detail-intro">
    <div class="container detail-editorial-grid">
      <div><p class="eyebrow">What we create</p><h2 class="section-heading">お店とお客様の間に、<br />もうひとつの接点を。</h2></div>
      <div class="detail-body-copy">
        <p>いつものお客様に新商品を知ってほしい。紙のスタンプカードを見直したい。お店の雰囲気が伝わる会員サービスを持ちたい。</p>
        <p>そんな思いから始める、お店専用のWebアプリです。スマートフォンのブラウザで開けるため、URLや店頭のQRコードからご案内する使い方を想定しています。</p>
        <p>お店に必要な機能を一緒に考え、デザインから日々の運用まで。小さく始めて、無理なく使い続けられる仕組みを目指します。</p>
      </div>
    </div>
    <div class="container detail-access-strip">
      <div><span class="detail-access-symbol" aria-hidden="true">URL</span><p><strong>見つけやすく</strong><span>URLやQRコードからアクセス</span></p></div>
      <div><span class="detail-access-symbol detail-home-symbol" aria-hidden="true">＋</span><p><strong>使いやすく</strong><span>ホーム画面への追加にも対応を検討</span></p></div>
      <div><span class="detail-access-symbol detail-brand-symbol" aria-hidden="true">a</span><p><strong>お店らしく</strong><span>ロゴや色、雰囲気を反映</span></p></div>
    </div>
  </section>

  <section class="section detail-features" id="features">
    <div class="container">
      <div class="detail-section-intro"><div><p class="eyebrow">Feature ideas</p><h2 class="section-heading">つながり方は、<br />お店に合わせて。</h2></div><p>すべてを詰め込むのではなく、必要なものから。<br />お店での使い方を想像しながら考えています。</p></div>
      <p class="detail-preparing-note"><span>検討中の機能</span>以下は機能候補です。完成済み・標準提供を示すものではありません。提供範囲は今後の実証やご要望に応じて決定します。</p>
      <div class="detail-feature-grid">
        {features.map((feature) => <article class="detail-feature">
          <div class:list={['detail-feature-art', `detail-art-${feature.kind}`]} aria-hidden="true">
            {feature.kind === 'member' && <div class="detail-mini-member"><span>MEMBERS CARD</span><b>your shop.</b><div class="detail-mini-barcode"></div></div>}
            {feature.kind === 'stamp' && <div class="detail-mini-stamps">{Array.from({ length: 8 }, (_, i) => <i class:list={{ filled: i < 5 }}>{i < 5 ? '✦' : ''}</i>)}</div>}
            {feature.kind === 'coupon' && <div class="detail-mini-coupon"><span>JUST FOR YOU</span><b>お店からの、<br />小さな楽しみ。</b><i>COUPON</i></div>}
            {feature.kind === 'news' && <div class="detail-mini-news"><span>FROM YOUR SHOP</span><b>季節のお知らせ</b><i></i><i></i><i></i></div>}
            {feature.kind === 'manage' && <div class="detail-mini-manage"><span>STORE DESK</span><div><i></i><i></i><i></i></div><hr /><hr /><hr /></div>}
            {feature.kind === 'insight' && <div class="detail-mini-insight"><span>お店の振り返り</span><div><i></i><i></i><i></i><i></i><i></i></div><small>利用状況の表示イメージ</small></div>}
          </div>
          <div class="detail-feature-copy"><p class="eyebrow">{feature.en}</p><h3>{feature.title}</h3><p class="detail-feature-name">{feature.name}</p><p>{feature.text}</p></div>
        </article>)}
      </div>
      <p class="detail-section-note">予約・取り置きなどは、ご要望や必要性に応じて検討します。表示した図は機能のイメージであり、実際の利用データではありません。</p>
    </div>
  </section>

  <section class="section detail-scenes">
    <div class="container detail-editorial-grid"><div><p class="eyebrow">For local shops</p><h2 class="section-heading">いつもの風景に、<br />新しい使い方を。</h2><p class="muted">以下は利用シーンの例です。<br />導入実績ではありません。</p></div><div class="detail-scene-list">{scenes.map((scene) => <article><p class="detail-scene-type">{scene.type}</p><h3>{scene.tag}</h3><p>{scene.text}</p></article>)}</div></div>
  </section>

  <section class="section detail-approach">
    <div class="container"><div class="detail-section-intro"><div><p class="eyebrow">Our approach</p><h2 class="section-heading">お店の個性と、<br />続けられる仕組み。</h2></div><p>見た目だけでなく、使い始めてからのことまで。<br />お店の規模と日常に合う導入を考えます。</p></div>
      <div class="detail-principles"><article><h3>お店のブランドを大切に。</h3><p>共通の仕組みを土台にしながら、ロゴや色、伝え方をお店に合わせて。必要な機能や表現の範囲を丁寧に確認します。</p></article><article><h3>運用する人の視点で。</h3><p>更新の頻度や接客の流れ、担当する方の使いやすさを考慮。店舗自身がアカウントや顧客データを管理する構造を基本に検討しています。</p></article><article><h3>導入後も、少しずつ。</h3><p>使い方を振り返りながら、継続的な運用・改善を目指します。具体的なサポート範囲は、サービスの準備と実証を通じて整えます。</p></article></div>
      <p class="detail-section-note">既存のLINE公式アカウントなどとの併用もご相談いただけます。個別のシステム連携は別途検討となります。売上や再来店率などの成果を保証するサービスではありません。</p>
    </div>
  </section>

  <section class="section detail-flow-section">
    <div class="container"><p class="eyebrow">Getting started</p><h2 class="section-heading">ご相談から、その先まで。</h2><p class="detail-flow-intro">まずはお店のことを聞くところから。<br />以下は、今後の導入の流れを示した案です。ご提案内容や準備状況により変更する場合があります。</p>
      <ol class="detail-flow">{flow.map((step) => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
    </div>
  </section>

  <section class="detail-bottom-cta"><div class="container"><div><p class="eyebrow">Let's talk</p><h2>「うちのお店なら？」を、<br />一緒に考えませんか。</h2><p>機能が決まっていなくても大丈夫。<br />まずは、お店のことをお聞かせください。</p></div><div class="detail-cta-actions"><a class="button button--primary" href="/contact/">無料相談・デモ相談</a><a class="detail-text-link" href="/pricing/">料金の考え方を見る</a></div></div></section>
</BaseLayout>
