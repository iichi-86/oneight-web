      <rect x="22" y="41" width="99" height="69" rx="7" fill="#fffefa" />
      <rect x="29" y="48" width="85" height="55" rx="2" fill="#f1f5e8" stroke="none" />
      <path d="M42 63h30m-30 11h51m-51 10h38" />
      <circle cx="100" cy="91" r="7" fill="#e4f35b" stroke="none" />
      <path d="m96.5 91 2 2 4-4" stroke-width="1.7" />
      <path d="M138 64h68v47h-68z" fill="#fffefa" />
      <path d="m132 63 8-19h63l8 19" fill="#f3c9bc" />
      <path d="M132 63c0 7 11 7 11 0 0 7 11 7 11 0 0 7 12 7 12 0 0 7 11 7 11 0 0 7 12 7 12 0 0 7 11 7 11 0 0 7 11 7 11 0" fill="#f3c9bc" />
      <path d="M154 45v17m23-17v17m-30 15h17v19h-17zM178 111V78h17v33" />
      <path d="M91 28c17-10 35-11 52-5" stroke="#91a187" stroke-dasharray="3 5" />
      <circle cx="202" cy="110" r="15" fill="#e4f35b" />
      <path d="m195 110 5 5 9-10" />
      <path d="M20 119h108m7 0h23" stroke="#b7c4af" />
